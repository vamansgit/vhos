# VHOS v2.4 Environment Configuration
# Copy to .env and fill in values

# Anthropic (for Claude Haiku intent classification)
ANTHROPIC_API_KEY=your-api-key-here

# Redis
REDIS_URL=redis://localhost:6379/0

# Demo mode (use Excel files instead of live FHIR)
USE_DEMO_DATA=true
DEMO_DATA_DIR=demo_data

# Auth secrets (CHANGE IN PRODUCTION)
JWT_SECRET=change-me-in-production-use-long-random-string
CAPABILITY_TOKEN_SECRET=change-me-in-production-32chars
AUDIT_HMAC_SECRET=change-me-in-production-audit-key

# FHIR
FHIR_BASE_URL=http://your-fhir-server/fhir
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=

# Telephony
EXOTEL_SID=
EXOTEL_TOKEN=
TWILIO_SID=
TWILIO_TOKEN=

# Messaging
WHATSAPP_TOKEN=
SMS_GATEWAY_KEY=

# TTS/STT
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
