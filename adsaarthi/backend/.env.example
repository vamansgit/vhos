# Copy to .env and fill in for production use. All values have safe
# development defaults (see app/config.py) — the app runs fully offline
# with mock ad data and template-based content generation if nothing is set.

ADSAARTHI_DATABASE_URL=sqlite:///./adsaarthi.db
ADSAARTHI_JWT_SECRET=change-me-in-production

# Ad platform OAuth — leave unset to use the deterministic mock connector.
ADSAARTHI_META_APP_ID=
ADSAARTHI_META_APP_SECRET=
ADSAARTHI_GOOGLE_CLIENT_ID=
ADSAARTHI_GOOGLE_CLIENT_SECRET=

# AI content generation — leave unset to use the template-based fallback.
ADSAARTHI_ANTHROPIC_API_KEY=
ADSAARTHI_ANTHROPIC_MODEL=claude-sonnet-5

ADSAARTHI_CORS_ORIGINS=["http://localhost:5173"]
