# Copy to .env and fill in for production use. All values have safe
# development defaults (see app/config.py) — the app runs fully offline
# with heuristic NL parsing and no external connectors if nothing is set.

NEXUS_DATABASE_URL=sqlite:///./nexus.db
NEXUS_JWT_SECRET=change-me-in-production

# AI layer — leave unset to use deterministic heuristic parsing/routing.
NEXUS_ANTHROPIC_API_KEY=
NEXUS_ANTHROPIC_MODEL=claude-sonnet-5

# Storefront/payment/B2B connectors — reserved for future real integrations.
NEXUS_SHOPIFY_API_KEY=
NEXUS_RAZORPAY_KEY_ID=

NEXUS_DOCUMENT_STORAGE_DIR=./document_vault
NEXUS_CORS_ORIGINS=["http://localhost:5174"]
